# PostgreSQL connection string (Vercel/Next runtime). NEON_DATABASE_URL is also supported.
DATABASE_URL=postgresql://user:password@localhost:5432/canvas_app
NEON_DATABASE_URL=postgresql://user:password@localhost:5432/canvas_app
# Direct Neon URL for migrations/drizzle-kit (not the -pooler host). Falls back to DATABASE_URL if omitted.
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/canvas_app

# Base URL for Better Auth (set to your app's URL)
BETTER_AUTH_URL=http://localhost:3000

# Ably server API key (server-only; add the same value in Vercel Environment Variables)
ABLY_API_KEY=your-ably-api-key
